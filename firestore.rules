rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.admin == true; }

    // The Home app should use Firebase Auth (anonymous or custom-token) before
    // enabling these production rules. Do not use a client-side PIN as proof of admin.
    match /referralAttributions/{referredCode} {
      allow read: if admin() || (signedIn() && request.auth.uid == referredCode);
      allow create: if signedIn()
        && request.auth.uid == referredCode
        && request.resource.data.referredCode == referredCode
        && request.resource.data.status == 'attributed'
        && !exists(/databases/$(database)/documents/referralAttributions/$(referredCode));
      allow update, delete: if admin();
    }

    match /referralDevices/{deviceId} {
      allow read: if admin();
      allow create: if signedIn()
        && request.resource.data.referredProfileCode == request.auth.uid
        && !exists(/databases/$(database)/documents/referralDevices/$(deviceId));
      allow update, delete: if admin();
    }

    match /referralUsers/{profileCode} {
      allow read: if admin() || (signedIn() && request.auth.uid == profileCode);
      allow create, update: if signedIn()
        && request.auth.uid == profileCode
        && request.resource.data.profileCode == profileCode;
      allow delete: if admin();
    }

    match /referralPhones/{phoneId} {
      allow read: if admin();
      // A phone reservation is immutable, so a second claim cannot reserve it.
      allow create: if signedIn()
        && request.resource.data.referredCode == request.auth.uid
        && !exists(/databases/$(database)/documents/referralPhones/$(phoneId));
      allow update, delete: if admin();
    }

    match /referralClaims/{claimId} {
      allow read: if admin() || (signedIn() && request.auth.uid == claimId);
      allow create: if signedIn()
        && request.auth.uid == claimId
        && request.resource.data.referredCode == claimId
        && request.resource.data.status == 'Pending'
        && request.resource.data.rewardAmount >= 10
        && request.resource.data.rewardAmount <= 20
        && !exists(/databases/$(database)/documents/referralClaims/$(claimId));
      allow update: if admin();
      allow delete: if admin();
    }

    match /referralPayouts/{payoutId} {
      allow read: if admin();
      allow write: if admin();
    }

    match /referralBalances/{profileCode} {
      allow read: if admin() || (signedIn() && request.auth.uid == profileCode);
      // Balance changes must be made by the Admin transaction only.
      allow create, update, delete: if admin();
    }

    // Share Count based withdrawal workflow. The client may create only a
    // pending request for its own authenticated UID; status changes are admin-only.
    match /withdraw_requests/{requestId} {
      allow read: if admin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.shareCountAtRequest >= 5
        && request.resource.data.phoneNumber is string
        && request.resource.data.deviceId is string
        && request.resource.data.amount >= 20;
      allow update, delete: if admin();
    }

    // Immutable reservations make duplicate phone/device requests fail inside
    // the same client transaction. The document IDs are normalized/hash keys.
    match /withdraw_request_phones/{phoneKey} {
      allow read: if admin();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.phoneKey == phoneKey
        && !exists(/databases/$(database)/documents/withdraw_request_phones/$(phoneKey));
      allow update, delete: if admin();
    }

    match /withdraw_request_devices/{deviceId} {
      allow read: if admin();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.deviceId == deviceId
        && !exists(/databases/$(database)/documents/withdraw_request_devices/$(deviceId));
      allow update, delete: if admin();
    }

    // Payout details may be saved before the user has any balance. Keep the
    // record private to the owner and Admin; payment is still Admin-reviewed.
    match /referralPayoutProfiles/{profileCode} {
      allow read: if admin() || (signedIn() && request.auth.uid == profileCode);
      allow create, update: if signedIn()
        && request.auth.uid == profileCode
        && request.resource.data.profileCode == profileCode
        && request.resource.data.phoneNumber is string
        && request.resource.data.payoutMethod in ['TrueMoney', 'WavePay', 'KPay'];
      allow delete: if admin();
    }

    match /referralWithdrawals/{withdrawalId} {
      allow read: if admin() || (signedIn() && resource.data.referrerCode == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.referrerCode == request.auth.uid
        && request.resource.data.status == 'Pending'
        && request.resource.data.phoneNumber is string
        && request.resource.data.email is string
        && request.resource.data.amount >= 20;
      allow update, delete: if admin();
    }

    match /adminNotifications/{notificationId} {
      allow read: if admin();
      allow create: if signedIn()
        && request.resource.data.type == 'withdrawal_request'
        && request.resource.data.referrerCode == request.auth.uid
        && request.resource.data.status == 'Unread';
      allow update, delete: if admin();
    }

    // Standalone Dailywage-Share landing-page activity. The Share page records
    // one referral event per device; Admin is the only reader/reviewer.
    match /shareReferrals/{deviceId} {
      allow read: if admin();
      allow create: if signedIn()
        && request.resource.data.referredDeviceId == deviceId
        && request.resource.data.referrerCode is string;
      allow update: if signedIn()
        && resource.data.referrerCode == request.resource.data.referrerCode
        && request.resource.data.referredDeviceId == deviceId;
      allow delete: if admin();
    }

    match /shareReferralDevices/{deviceId} {
      allow read: if admin();
      allow create: if signedIn()
        && request.resource.data.deviceId == deviceId
        && request.resource.data.referrerCode is string;
      allow update, delete: if admin();
    }

    // Existing device registry: keep app registration possible, but reserve
    // delete/write review for an authenticated admin in production.
    match /devices/{deviceId} {
      allow read, create, update: if signedIn();
      allow delete: if admin();
    }
  }
}
